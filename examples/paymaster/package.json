{
  "name": "swig-paymaster-examples",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Swig Paymaster - Solana transaction sponsorship service",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm && bun run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "example:transfer": "bun run examples/transfer-example.ts",
    "example:basic": "bun run examples/basic.ts",
    "example:backend": "bun run examples/node-backend.ts"
  },
  "keywords": [
    "solana",
    "paymaster",
    "transaction",
    "sponsorship",
    "blockchain",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@swig-paymaster/classic": "workspace:*",
    "@swig-paymaster/core": "workspace:*",
    "@swig-paymaster/kit": "workspace:*"
  },
  "devDependencies": {
    "@solana/kit": "^5.0.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/memo": "^0.10.0",
    "@solana/web3.js": "^1.98.4",
    "@types/bun": "^1.3.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}