{
  "name": "@swig-wallet/mcp-server",
  "version": "1.0.5",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/anagrambuild/swig-ts",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "description": "MCP server for Swig smart wallet operations on Solana",
  "bin": {
    "swig-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build-pkg": "tsup-node",
    "build": "tsup-node",
    "dev": "tsup-node --watch",
    "start": "node dist/index.js",
    "lint": "eslint --config ../../eslint.config.mjs --ext js,ts,tsx src",
    "lint:fix": "eslint --config ../../eslint.config.mjs --ext js,ts,tsx src --fix",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@solana/web3.js": "^1.98.0",
    "@swig-wallet/classic": "workspace:*",
    "@swig-wallet/paymaster-classic": "workspace:*",
    "bs58": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.2.0",
    "typescript": "^5.5.3"
  }
}
