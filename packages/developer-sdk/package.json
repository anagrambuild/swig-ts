{
  "name": "@swig-wallet/developer-sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anagrambuild/swig-ts",
    "directory": "packages/developer-sdk"
  },
  "type": "module",
  "scripts": {
    "build-pkg": "tsup-node",
    "build": "tsup-node",
    "dev": "tsup-node --watch",
    "lint": "eslint --config ../../eslint.config.mjs --ext js,ts,tsx src",
    "lint:fix": "eslint --config ../../eslint.config.mjs --ext js,ts,tsx src --fix",
    "smoke:local": "bun run scripts/local-transaction-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./server/next": {
      "types": "./dist/server/next.d.ts",
      "import": "./dist/server/next.js",
      "require": "./dist/server/next.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@swig-wallet/lib": "workspace:*"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/bun": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.3"
  }
}
